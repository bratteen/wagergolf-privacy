{
  "name": "wagergolf-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.8.0"
  },
  "description": "wagergolf.se, marknadssajt + integritetspolicy + villkor (11ty)",
  "imports": {
    "#data/*": "./_data/*",
    "#lib/*": "./lib/*"
  },
  "scripts": {
    "build": "rm -rf _site && eleventy",
    "check:legal": "node scripts/check-legal.mjs",
    "test": "node --test 'tests/**/*.test.{js,mjs}'",
    "validate:html": "html-validate _site/privacy/index.html _site/terms/index.html",
    "check": "npm run build && npm test && npm run check:legal && npm run validate:html",
    "dev": "eleventy --serve",
    "deploy": "npm run check && npx wrangler pages deploy _site --project-name=wagergolf --branch=main && npm run indexnow",
    "indexnow": "node scripts/indexnow.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "html-validate": "11.5.6",
    "wrangler": "^4.119.0"
  },
  "overrides": {
    "@11ty/recursive-copy": {
      "minimatch": "10.2.5"
    },
    "undici": "7.29.0"
  }
}
