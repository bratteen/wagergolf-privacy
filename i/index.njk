<main id="main-content" tabindex="-1" class="invite" style="max-width:520px;margin:0 auto;padding:48px 20px 80px;text-align:center">
  <div id="invite-card">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;color:var(--brass-deep);font-size:12px;margin-bottom:16px">Inbjudan</p>
    <h1 id="invite-title" style="font-size:clamp(1.4rem,5vw,2rem);margin-bottom:16px">Du har blivit inbjuden till Wager Golf</h1>
    <p id="invite-sub" style="color:#555;margin-bottom:32px">Spela om något med dina golfkompisar, vi räknar ut allt åt er.</p>
    {#- href pekar på /ladda-ner, inte direkt på en butik: funktionen avgör
        butik server-side och fungerar därför utan JavaScript. Tidigare var
        App Store-länken hårdkodad här och skrevs om av inline-JS som CSP:n
        blockerade, så varje Android-användare hamnade i Apples butik.
        data-attributen läses av download-link.js, som väljer butik och skriver
        in kampanjen i ct. -#}
    <div data-release-open hidden>
      <a id="dl" href="{{ site.downloadUrls[lang].generic }}" class="btn" data-download-link data-store-link data-ios-url="{{ site.downloadUrls[lang].ios }}" data-android-url="{{ site.downloadUrls[lang].android }}" style="display:inline-block;background:#0a2e21;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:600;font-size:1rem">Ladda ner appen</a>
      <p style="color:#666;font-size:13px;margin-top:20px">Har du redan appen? Tryck på den här länken igen så kopplas ni i appen.</p>
    </div>
    <div data-release-closed>
      <span class="btn" style="display:inline-block;background:#0a2e21;color:#fff;padding:14px 32px;border-radius:8px;font-weight:600;font-size:1rem;opacity:.8;cursor:not-allowed">Inte tillgänglig här än</span>
      <p style="color:#666;font-size:13px;margin-top:20px">Version 1.8.0 är förberedd för 14 marknader. Ingen butikslänk aktiveras förrän appen kan installeras i landet.</p>
    </div>
  </div>
  <script defer src="/assets/js/invite.js{% if assets.invite %}?v={{ assets.invite }}{% endif %}" data-api="{{ site.api }}" data-lang="{{ lang }}"></script>
</main>
