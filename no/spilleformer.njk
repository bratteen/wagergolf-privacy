  <div class="wrap hub-section">
    {#- Kategoriene er de samme strengene som guidenes frontmatter, altså
        norsk her og svensk på den svenske pillarsiden. byCategory matcher på
        verdien, så listen må følge språket. -#}
    {%- set cats = ["Klassikere", "Hullspill", "Lag", "Sidespill"] %}
    {%- for cat in cats %}
    {%- set inCat = collections.guides | byCategory(cat, lang) %}
    {%- if inCat.length %}
    <h2 class="hub-cat">{{ cat }}</h2>
    <div class="hub-grid">
      {%- for g in inCat %}
      <a class="hub-card" href="{{ g.url }}">
        <h3>{{ g.data.format }}{% if g.data.altName %} ({{ g.data.altName }}){% endif %}</h3>
        <p>{{ g.data.cardText or g.data.lede }}</p>
        <span class="meta">{{ g.data.players }}</span>
      </a>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- endfor %}
  </div>

