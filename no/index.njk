  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow on-dark">Nå på App Store og Google Play</span>
          <h1>Spill om <span class="accent">mer enn æren.</span></h1>
          <p class="lede">Wager Golf holder styr på regningen når gjengen gjør opp på banen. 21 spilleformer regnes automatisk, og potten er gjort opp når runden er over. Ingen papir, ingen kalkulator, ingen krangel ved det 19. hullet.</p>
          <div class="cta-row">
            {% set storePlats = "startsida-hero" %}
            {% include "store-badges.njk" %}
            <span class="cta-note">Gratis, for iPhone og Android</span>
          </div>
          <p class="hero-proof">
            <span class="hero-proof-stars" role="img" aria-label="5 av 5 stjerner">{% for i in range(5) %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>{% endfor %}</span>
