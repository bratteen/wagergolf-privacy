            <div class="ftitle">Side bets</div>
            <ul>
              <li><a href="{% guideUrl "birdiepott" %}">Birdie pot</a></li><li><a href="{% guideUrl "snake" %}">Snake</a></li><li><a href="{% guideUrl "sandie" %}">Sandie</a></li>
              <li><a href="{% guideUrl "narmast-flaggan" %}">Closest to the pin</a></li><li><a href="{% guideUrl "langst-drive" %}">Longest drive</a></li><li><a href="{% guideUrl "golfpoker" %}">Golf poker</a></li>
