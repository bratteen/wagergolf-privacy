---
  <main id="top">
    <!-- HERO -->
    <section class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <span class="eyebrow on-dark">Now on the App Store and Google Play</span>
          <h1>Play for <span class="accent">more than pride.</span></h1>
          <p class="lede">Wager Golf keeps the count when the group settles it on the course. 21 game formats worked out automatically, and the pot squared up by the time the round ends. No paper, no calculator, no arguing at the 19th.</p>
          <div class="cta-row">
            {% set storePlats = "startsida-hero" %}
            {% include "store-badges.njk" %}
            <span class="cta-note">Free, for iPhone and Android</span>
          </div>
          <p class="hero-proof">
            <span class="hero-proof-stars" role="img" aria-label="5 out of 5 stars">{% for i in range(5) %}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>{% endfor %}</span>
            <span class="hero-proof-text">5.0 out of 5 on the App Store</span>
          </p>
        </div>
        <div class="hero-phone">
          <img src="{% shot "live" %}" alt="Wager Golf live scorecard on iPhone" loading="eager" fetchpriority="high" width="640" height="1306">
          <span class="hero-stamp">Hole by hole, in real time</span>
        </div>
      </div>
    </section>

    <div class="holestrip" aria-hidden="true">
      <div class="wrap holestrip-inner">
        <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span>
