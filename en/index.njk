    <section class="closing">
      <div class="wrap reveal">
        <span class="eyebrow">Ready for the next round</span>
        <h2 style="margin-top:14px">Settle up in <span class="accent">a second.</span></h2>
        <p>Download it free, add the group and start playing.</p>
        {% set storePlats = "startsida-avslut" %}
        {% include "store-badges.njk" %}
