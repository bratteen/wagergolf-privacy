<main class="invite" style="max-width:520px;margin:0 auto;padding:48px 20px 80px;text-align:center">
  <div id="invite-card">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;color:#b08d57;font-size:12px;margin-bottom:16px">Invitation</p>
    <h1 id="invite-title" style="font-size:clamp(1.4rem,5vw,2rem);margin-bottom:16px">You have been invited to Wager Golf</h1>
    <p id="invite-sub" style="color:#555;margin-bottom:32px">Play for something with your golf mates, and we will work it all out for you.</p>
    {#- href pekar på /ladda-ner, inte direkt på en butik: funktionen avgör
        butik server-side och fungerar därför utan JavaScript. Marknaden går i
        query-strängen, se downloadPath i _data/routes.js. -#}
    <a id="dl" href="{{ routes.locales[lang].downloadPath }}" class="btn" data-download-link data-store-link data-ios-url="{{ site.storeUrls[lang].appStore }}" data-android-url="{{ site.storeUrls[lang].playStore }}" style="display:inline-block;background:#0a2e21;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:600;font-size:1rem">Download the app</a>
    <p style="color:#888;font-size:13px;margin-top:20px">Already have the app? Tap this link again and it will connect you in the app.</p>
  </div>
  <script defer src="/assets/js/invite.js{% if assets.invite %}?v={{ assets.invite }}{% endif %}" data-api="{{ site.api }}"></script>
</main>
