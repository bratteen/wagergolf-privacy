---
permalink: /en/i/index.html
layout: base.njk
key: page:invite
title: You have been invited to Wager Golf
description: Play for something with your golf mates, and we will work it all out for you.
eleventyExcludeFromCollections: true
extraHead: '<meta name="robots" content="noindex, nofollow">'
---
<main id="main-content" tabindex="-1" class="invite" style="max-width:520px;margin:0 auto;padding:48px 20px 80px;text-align:center">
  <div id="invite-card">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;color:var(--brass-deep);font-size:12px;margin-bottom:16px">Invitation</p>
    <h1 id="invite-title" style="font-size:clamp(1.4rem,5vw,2rem);margin-bottom:16px">You have been invited to Wager Golf</h1>
    <p id="invite-sub" style="color:#555;margin-bottom:32px">Play for something with your golf mates, and we will work it all out for you.</p>
    {#- href pekar på /ladda-ner, inte direkt på en butik: funktionen avgör
        butik server-side och fungerar därför utan JavaScript. Marknaden går i
        query-strängen, se downloadPath i _data/routes.js. -#}
    <div data-release-open hidden>
      <a id="dl" href="{{ site.downloadUrls[lang].generic }}" class="btn" data-download-link data-store-link data-ios-url="{{ site.downloadUrls[lang].ios }}" data-android-url="{{ site.downloadUrls[lang].android }}" style="display:inline-block;background:#0a2e21;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:600;font-size:1rem">Download the app</a>
      <p style="color:#666;font-size:13px;margin-top:20px">Already have the app? Tap this link again to connect in Wager Golf.</p>
    </div>
    <div data-release-closed>
      <span class="btn" style="display:inline-block;background:#0a2e21;color:#fff;padding:14px 32px;border-radius:8px;font-weight:600;font-size:1rem;opacity:.8;cursor:not-allowed">Not available here yet</span>
      <p style="color:#666;font-size:13px;margin-top:20px">Version 1.7.1 is prepared for 13 markets. No store link will be enabled until the app can be installed in the country.</p>
    </div>
  </div>
  <script defer src="/assets/js/invite.js{% if assets.invite %}?v={{ assets.invite }}{% endif %}" data-api="{{ site.api }}" data-lang="{{ lang }}"></script>
</main>
