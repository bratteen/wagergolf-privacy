eleventyExcludeFromCollections: true
extraHead: '<meta name="robots" content="noindex, nofollow">'
---
<main id="main-content" tabindex="-1" class="invite" style="max-width:520px;margin:0 auto;padding:48px 20px 80px;text-align:center">
  <div id="invite-card">
    <p class="eyebrow" style="letter-spacing:2px;text-transform:uppercase;color:var(--brass-deep);font-size:12px;margin-bottom:16px">Invitation</p>
    <h1 id="invite-title" style="font-size:clamp(1.4rem,5vw,2rem);margin-bottom:16px">Du er blevet inviteret til Wager Golf</h1>
    <p id="invite-sub" style="color:#555;margin-bottom:32px">Spil om noget med dine golfmakkere, vi regner det hele ud for jer.</p>
    {#- href pekar på /ladda-ner, inte direkt på en butik: funktionen avgör
        butik server-side och fungerar därför utan JavaScript. Marknaden går i
        query-strängen, se downloadPath i _data/routes.js. -#}
    <div data-release-open hidden>
      <a id="dl" href="{{ site.downloadUrls[lang].generic }}" class="btn" data-download-link data-store-link data-ios-url="{{ site.downloadUrls[lang].ios }}" data-android-url="{{ site.downloadUrls[lang].android }}" style="display:inline-block;background:#0a2e21;color:#fff;padding:14px 32px;border-radius:8px;text-decoration:none;font-weight:600;font-size:1rem">Hent appen</a>
      <p style="color:#666;font-size:13px;margin-top:20px">Har du allerede appen? Tryk på linket igen, så forbindes I i appen.</p>
    </div>
    <div data-release-closed>
      <span class="btn" style="display:inline-block;background:#0a2e21;color:#fff;padding:14px 32px;border-radius:8px;font-weight:600;font-size:1rem;opacity:.8;cursor:not-allowed">Ikke tilgængelig her endnu</span>
      <p style="color:#666;font-size:13px;margin-top:20px">Version 1.7.1 er klargjort til 13 markeder. Ingen butikslink aktiveres, før appen kan hentes i landet.</p>
    </div>
  </div>
  <script defer src="/assets/js/invite.js{% if assets.invite %}?v={{ assets.invite }}{% endif %}" data-api="{{ site.api }}" data-lang="{{ lang }}"></script>
</main>
