  <div class="wrap hub-section">
    {#- Kategorierne er de samme strenge som guidernes frontmatter, altså
        dansk her og svensk på den svenske pillarside. byCategory matcher på
        værdien, så listen skal følge sproget. -#}
    {%- set cats = ["Klassikere", "Hulspil", "Hold", "Sidespil"] %}
    {%- for cat in cats %}
    {%- set inCat = collections.guides | byCategory(cat, lang) %}
    {%- if inCat.length %}
    <h2 class="hub-cat">{{ cat }}</h2>
    <div class="hub-grid">
      {%- for g in inCat %}
      <a class="hub-card" href="{{ g.url }}">
        <h3>{{ g.data.format }}{% if g.data.altName %} ({{ g.data.altName }}){% endif %}</h3>
        <p>{{ g.data.cardText or g.data.lede }}</p>
        <span class="meta">{{ g.data.players }}</span>
      </a>
      {%- endfor %}
    </div>
    {%- endif %}
    {%- endfor %}
  </div>

  <div class="wrap hub-extra">
