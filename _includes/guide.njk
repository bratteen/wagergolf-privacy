---
layout: base.njk
---
<main>
  <section class="subhero">
    <div class="subhero-inner">
      <div class="breadcrumb">
        <a href="/">Hem</a><span class="sep">/</span><a href="/spelformer/">Spelformer</a><span class="sep">/</span><span>{{ format }}</span>
      </div>
      <h1>{{ h1 or title }}</h1>
      {% if lede %}<p>{{ lede }}</p>{% endif %}
      <p class="guide-byline">Av <a href="/om/">Gustaf Bratt</a>{% if updated %} · Uppdaterad {{ updated | localDate(lang) }}{% endif %}</p>
      <div class="guide-meta-row">
        {% if players %}<span class="guide-chip">{{ players }}</span>{% endif %}
        {% if category %}<span class="guide-chip outline">{{ category }}</span>{% endif %}
      </div>
    </div>
  </section>

  <article class="article-wrap">
    <div class="article">
      {{ content | safe }}
    </div>
  </article>

  {% if faq %}
  <section class="faq">
    <h2>Vanliga frågor</h2>
    {% for f in faq %}
    <div class="faq-item">
      <p class="faq-q">{{ f.q }}</p>
      <p class="faq-a">{{ f.a }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  <section class="guide-cta">
    <h2>Slipp räkna {{ format }} för hand</h2>
    <p>Wager Golf scorar rundan automatiskt med rätt WHS-handicap och gör upp med Swish när ni går in.</p>
    {% set storePlats = "guide" %}
    {% include "store-badges.njk" %}
  </section>

  {% if related %}
  <section class="related">
    <h2>Fler spelformer</h2>
    <div class="related-links">
      {%- for slug in related %}{%- for g in collections.guides %}{%- if g.data.slug == slug %}<a href="{{ g.url }}">{{ g.data.format }}</a>{%- endif %}{%- endfor %}{%- endfor %}
    </div>
  </section>
  {% endif %}
</main>
