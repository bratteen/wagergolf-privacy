{#- Språkväljaren bygger normalt på samma alternates-lista som hreflang och
    länkar till motsvarande sida. Invite-URL:en är dynamisk och ligger utanför
    collections; där byter en relativ ?l=-länk språk utan att tappa token som
    ligger kvar i sökvägen.

    Elva fullständiga språknamn ryms inte på en rad. Desktop och sidfot
    använder ett kompakt native details; mobilmenyn visar samma riktiga länkar
    i ett skrollbart rutnät. -#}
{%- macro languageOptions(items, current, invite, homeFallback) -%}
  {%- for item in items -%}
    {%- if invite or homeFallback -%}
      {%- set code = item -%}
      {%- set target = ('?l=' ~ code) if invite else routes.homeFor(code) -%}
      {%- set targetHreflang = routes.locales[code].hreflang -%}
    {%- else -%}
      {%- set code = item.lang -%}
      {%- set target = item.url -%}
      {%- set targetHreflang = item.hreflang -%}
    {%- endif -%}
    {%- if code == current -%}
  <span class="lang-current" lang="{{ routes.locales[code].htmlLang }}" aria-current="true">{{ routes.locales[code].label }}</span>
    {%- else -%}
  <a href="{{ target }}" hreflang="{{ targetHreflang }}" lang="{{ routes.locales[code].htmlLang }}" data-lang-link="{{ code }}">{{ routes.locales[code].label }}</a>
    {%- endif -%}
  {%- endfor -%}
{%- endmacro -%}

{%- set inviteSwitcher = key == 'page:invite' -%}
{%- set homeSwitcher = key == 'page:404' -%}
{%- set alts = collections.all | alternates(key, routes, lang) -%}
{%- set switchItems = routes.publishedLocales if inviteSwitcher or homeSwitcher else alts.links -%}
{%- if switchItems.length > 1 %}
  {%- if langSwitchMode == "expanded" %}
<div class="lang-switch lang-switch-expanded" role="group" aria-label="{{ t.switcher.label }}">
{{ languageOptions(switchItems, lang, inviteSwitcher, homeSwitcher) }}
</div>
  {%- else %}
<details class="lang-switch lang-switch-compact">
  <summary aria-label="{{ t.switcher.label }}: {{ routes.locales[lang].label }}">
    <svg aria-hidden="true" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"/></svg>
    <span lang="{{ routes.locales[lang].htmlLang }}">{{ routes.locales[lang].label }}</span>
  </summary>
  <div class="lang-options" role="group" aria-label="{{ t.switcher.label }}">
{{ languageOptions(switchItems, lang, inviteSwitcher, homeSwitcher) }}
  </div>
</details>
  {%- endif %}
{%- endif -%}
