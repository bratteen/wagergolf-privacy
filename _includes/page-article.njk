---
layout: base.njk
---
<main id="main-content" tabindex="-1">
  <section class="subhero">
    <div class="subhero-inner">
      {% if breadcrumb %}
      <div class="breadcrumb">
        <a href="{{ routes.homeFor(lang) }}">{{ t.breadcrumb.home }}</a>
        {%- for c in breadcrumb %}<span class="sep">/</span>{% if c.url %}<a href="{{ c.url }}">{{ c.name }}</a>{% else %}<span>{{ c.name }}</span>{% endif %}{%- endfor %}
      </div>
      {% endif %}
      <h1>{{ h1 or title }}</h1>
      {% if lede %}<p>{{ lede }}</p>{% endif %}
      {% if byline %}<p class="guide-byline">{{ t.byline.by }} <a href="{{ routes.pathFor(lang, 'about') }}">Gustaf Bratt</a>{% if updated %} · {{ t.byline.updated }} {{ updated | localDate(lang) }}{% endif %}</p>{% endif %}
    </div>
  </section>

  <article class="article-wrap">
    <div class="article">
      {{ content | safe }}
    </div>
  </article>

  {% if faq %}
  <section class="faq">
    <h2>{{ t.faq.heading }}</h2>
    {% for f in faq %}
    <div class="faq-item">
      <p class="faq-q">{{ f.q }}</p>
      <p class="faq-a">{{ f.a }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if ctaHeading %}
  <section class="guide-cta">
    <h2>{{ ctaHeading }}</h2>
    <p>{{ ctaText or t.article.ctaText }}</p>
    {% set storePlats = "artikel" %}
    {% include "store-badges.njk" %}
  </section>
  {% endif %}

  {% if relatedLinks %}
  <section class="related">
    <h2>{{ t.article.related }}</h2>
    <div class="related-links">
      {%- for r in relatedLinks %}<a href="{{ r.url }}">{{ r.name }}</a>{%- endfor %}
    </div>
  </section>
  {% endif %}
</main>
