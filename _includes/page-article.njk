---
layout: base.njk
---
<main>
  <section class="subhero">
    <div class="subhero-inner">
      {% if breadcrumb %}
      <div class="breadcrumb">
        <a href="/">Hem</a>
        {%- for c in breadcrumb %}<span class="sep">/</span>{% if c.url %}<a href="{{ c.url }}">{{ c.name }}</a>{% else %}<span>{{ c.name }}</span>{% endif %}{%- endfor %}
      </div>
      {% endif %}
      <h1>{{ h1 or title }}</h1>
      {% if lede %}<p>{{ lede }}</p>{% endif %}
      {% if byline %}<p class="guide-byline">Av <a href="/om/">Gustaf Bratt</a>{% if updated %} · Uppdaterad {{ updated | svDate }}{% endif %}</p>{% endif %}
    </div>
  </section>

  <article class="article-wrap">
    <div class="article">
      {{ content | safe }}
    </div>
  </article>

  {% if faq %}
  <section class="faq">
    <h2>Vanliga frågor</h2>
    {% for f in faq %}
    <div class="faq-item">
      <p class="faq-q">{{ f.q }}</p>
      <p class="faq-a">{{ f.a }}</p>
    </div>
    {% endfor %}
  </section>
  {% endif %}

  {% if ctaHeading %}
  <section class="guide-cta">
    <h2>{{ ctaHeading }}</h2>
    <p>{{ ctaText or "Wager Golf scorar rundan automatiskt med rätt WHS-handicap och gör upp med Swish när ni går in." }}</p>
    {% set storePlats = "artikel" %}
    {% include "store-badges.njk" %}
  </section>
  {% endif %}

  {% if relatedLinks %}
  <section class="related">
    <h2>Läs vidare</h2>
    <div class="related-links">
      {%- for r in relatedLinks %}<a href="{{ r.url }}">{{ r.name }}</a>{%- endfor %}
    </div>
  </section>
  {% endif %}
</main>
