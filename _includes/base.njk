<!DOCTYPE html>
<html lang="{{ routes.locales[lang].htmlLang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#0a2e21">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- set alts = collections.all | alternates(key, routes, lang) %}
{%- for a in alts.links %}
  <link rel="alternate" hreflang="{{ a.hreflang }}" href="{{ site.url }}{{ a.url }}">
{%- endfor %}
{%- if alts.xDefault %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alts.xDefault }}">
{%- endif %}

  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ ogImage or site.ogImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or title }}">
  <meta name="twitter:description" content="{{ ogDescription or description }}">
  <meta name="twitter:image" content="{{ ogImage or site.ogImage }}">

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">

  <link rel="preload" href="/assets/fonts/playfair-display-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-mono-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/fonts/fonts.css{% if assets.fonts %}?v={{ assets.fonts }}{% endif %}">
  <link rel="stylesheet" href="/assets/css/site.css{% if assets.css %}?v={{ assets.css }}{% endif %}">

  {#- Releasegrinden får aldrig vänta på en tredjepartsleverantör. Ladda dess
      lokala script före eventuella analytics-script. Den statiska sidan är
      fail-closed tills /market-status bekräftar ett öppet land. -#}
  <script defer src="/assets/js/release-status.js{% if assets.releaseStatus %}?v={{ assets.releaseStatus }}{% endif %}"></script>

  {% if structuredData %}<script type="application/ld+json">{{ structuredData | safe }}</script>{% endif %}
  {%- if not routes.publishedLocales.includes(lang) %}
  {#- Språkkatalogerna byggs och deployas även innan språket är publicerat, så
      att en färdig översättning går att granska i skarp miljö. Men sidorna är
      då publikt nåbara utan att ligga i sitemap eller hreflang-grafen, och en
      halvfärdig översättning i indexet drar ner hela domänen. noindex tas bort
      automatiskt i samma stund språket läggs till i publishedLocales. -#}
  <meta name="robots" content="noindex">
  {%- endif %}
  {% if extraHead %}{{ extraHead | safe }}{% endif %}
  {% if site.cfBeaconToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfBeaconToken }}"}'></script>{% endif %}
  {% if site.umami.websiteId %}<script defer src="{{ site.umami.src }}" data-website-id="{{ site.umami.websiteId }}"></script>
  {% if site.umami.recorderSrc %}<script defer src="/assets/js/replay-sample.js{% if assets.replay %}?v={{ assets.replay }}{% endif %}" data-recorder-src="{{ site.umami.recorderSrc }}" data-website-id="{{ site.umami.websiteId }}" data-sample-rate="{{ site.umami.replaySampleRate }}"></script>{% endif %}{% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %} data-release-locale="{{ lang }}">
  <a class="skip-link" href="#main-content">{{ t.skipLink }}</a>
  {%- include "language-banner.njk" %}
  <header>
    <div class="wrap nav">
      <a class="brandmark" href="{{ routes.homeFor(lang) }}" aria-label="Wager Golf">
        <img src="/assets/logo.png" alt="" width="42" height="42">
        <span>WAGER GOLF</span>
      </a>
      <nav class="nav-links" aria-label="{{ t.nav.primaryLabel }}">
        <a href="{{ routes.homeFor(lang) }}#funktioner">{{ t.nav.features }}</a>
        <a class="nav-keep" href="{{ routes.pathFor(lang, 'formats') }}">{{ t.nav.formats }}</a>
        <a class="nav-cta" data-release-open hidden href="{{ site.downloadUrls[lang].generic }}" data-download-link data-store-link data-ios-url="{{ site.downloadUrls[lang].ios }}" data-android-url="{{ site.downloadUrls[lang].android }}" data-umami-event="ladda-ner-klick" data-umami-event-plats="nav">{{ t.nav.download }}</a>
        <span class="nav-cta is-disabled" data-release-closed>{{ t.nav.unavailable }}</span>
        {#- <div>, inte <nav>: den här inkluderingen ligger inuti
            <nav class="nav-links"> ovan, och ett nästlat nav-landmark är
            förvirrande för skärmläsare. Se kommentaren i
            language-switcher.njk. -#}
        {%- set langSwitchMode = "compact" %}
        {%- include "language-switcher.njk" %}
      </nav>
      {#- På smala skärmar ryms inte både ordmärket, butiksknappen,
          innehållslänkarna och elva fullständiga språknamn på en rad.
          Ett native <details> ger en tangentbordsstyrd meny utan JavaScript,
          samtidigt som alla språk ligger kvar som riktiga länkar i DOM:en. -#}
      <div class="mobile-nav">
        <a class="nav-cta" data-release-open hidden href="{{ site.downloadUrls[lang].generic }}" data-download-link data-store-link data-ios-url="{{ site.downloadUrls[lang].ios }}" data-android-url="{{ site.downloadUrls[lang].android }}" data-umami-event="ladda-ner-klick" data-umami-event-plats="nav">{{ t.nav.download }}</a>
        <span class="nav-cta is-disabled" data-release-closed><span class="mobile-status-long">{{ t.nav.unavailable }}</span><span aria-hidden="true">{{ t.nav.soon }}</span></span>
        <details class="mobile-menu">
          <summary aria-label="Wager Golf: {{ t.nav.formats }}, {{ t.switcher.label }}">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M4 7h16M4 12h16M4 17h16"/>
            </svg>
          </summary>
          <div class="mobile-menu-panel">
            <nav class="mobile-menu-links" aria-label="{{ t.nav.mobileLabel }}">
              <a href="{{ routes.homeFor(lang) }}#funktioner">{{ t.nav.features }}</a>
              <a href="{{ routes.pathFor(lang, 'formats') }}">{{ t.nav.formats }}</a>
            </nav>
            {%- set langSwitchMode = "expanded" %}
            {%- include "language-switcher.njk" %}
          </div>
        </details>
      </div>
    </div>
  </header>

  {{ content | safe }}

  <footer>
    <div class="wrap">
      <div class="foot-top">
        <div class="foot-brand">
          <img src="/assets/logo.png" alt="" width="34" height="34">
          <span>Wager Golf</span>
        </div>
        <nav class="foot-links" aria-label="{{ t.footer.navigationLabel }}">
          <a href="{{ routes.pathFor(lang, 'formats') }}">{{ t.footer.formats }}</a>
          <a href="{{ routes.pathFor(lang, 'glossary') }}">{{ t.footer.glossary }}</a>
          <a href="{{ routes.pathFor(lang, 'about') }}">{{ t.footer.about }}</a>
          {% if lang == "sv" %}
          <a href="/privacy/">{{ t.footer.privacy }}</a>
          <a href="/terms/">{{ t.footer.terms }}</a>
          {% else %}
          <a href="/privacy/#english">{{ t.footer.privacy }}</a>
          <a href="/terms/#english">{{ t.footer.terms }}</a>
          {% endif %}
          <a href="mailto:{{ site.email }}">{{ t.footer.contact }}</a>
        </nav>
        {%- set langSwitchMode = "compact" %}
        {%- include "language-switcher.njk" %}
      </div>
      <div class="foot-bottom">
        <span>© Gustaf Bratt</span>
        <span>{{ t.footer.tagline }}</span>
      </div>
    </div>
  </footer>

  <script defer src="/assets/js/reveal.js"></script>
  <script defer src="/assets/js/download-link.js{% if assets.download %}?v={{ assets.download }}{% endif %}"></script>
  <script defer src="/assets/js/mobile-menu.js{% if assets.mobileMenu %}?v={{ assets.mobileMenu }}{% endif %}"></script>
</body>
</html>
