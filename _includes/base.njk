<!DOCTYPE html>
<html lang="{{ routes.locales[lang].htmlLang }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">
  <meta name="theme-color" content="#0a2e21">
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
{%- set alts = collections.all | alternates(key, routes) %}
{%- for a in alts.links %}
  <link rel="alternate" hreflang="{{ a.hreflang }}" href="{{ site.url }}{{ a.url }}">
{%- endfor %}
{%- if alts.xDefault %}
  <link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ alts.xDefault }}">
{%- endif %}

  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  <meta property="og:type" content="{{ ogType or 'website' }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ ogImage or site.ogImage }}">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ ogTitle or title }}">
  <meta name="twitter:description" content="{{ ogDescription or description }}">
  <meta name="twitter:image" content="{{ ogImage or site.ogImage }}">

  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png">
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png">

  <link rel="preload" href="/assets/fonts/playfair-display-700.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/ibm-plex-mono-600.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/fonts/fonts.css{% if assets.fonts %}?v={{ assets.fonts }}{% endif %}">
  <link rel="stylesheet" href="/assets/css/site.css{% if assets.css %}?v={{ assets.css }}{% endif %}">

  {% if structuredData %}<script type="application/ld+json">{{ structuredData | safe }}</script>{% endif %}
  {% if extraHead %}{{ extraHead | safe }}{% endif %}
  {% if site.cfBeaconToken %}<script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.cfBeaconToken }}"}'></script>{% endif %}
  {% if site.umami.websiteId %}<script defer src="{{ site.umami.src }}" data-website-id="{{ site.umami.websiteId }}"></script>
  {% if site.umami.recorderSrc %}<script defer src="/assets/js/replay-sample.js{% if assets.replay %}?v={{ assets.replay }}{% endif %}" data-recorder-src="{{ site.umami.recorderSrc }}" data-website-id="{{ site.umami.websiteId }}" data-sample-rate="{{ site.umami.replaySampleRate }}"></script>{% endif %}{% endif %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <header>
    <div class="wrap nav">
      <a class="brandmark" href="{{ routes.homeFor(lang) }}" aria-label="Wager Golf">
        <img src="/assets/logo.png" alt="" width="42" height="42">
        <span>WAGER GOLF</span>
      </a>
      <nav class="nav-links">
        <a href="{{ routes.homeFor(lang) }}#funktioner">{{ t.nav.features }}</a>
        <a class="nav-keep" href="{{ routes.pathFor(lang, 'formats') }}">{{ t.nav.formats }}</a>
        <a class="nav-cta" href="{{ routes.locales[lang].prefix }}/{{ routes.locales[lang].download }}" data-download-link data-ios-url="{{ site.appStoreUrl }}" data-android-url="{{ site.playStoreUrl }}" data-umami-event="ladda-ner-klick" data-umami-event-plats="nav">{{ t.nav.download }}</a>
        {%- include "language-switcher.njk" %}
      </nav>
    </div>
  </header>

  {{ content | safe }}

  <footer>
    <div class="wrap">
      <div class="foot-top">
        <div class="foot-brand">
          <img src="/assets/logo.png" alt="" width="34" height="34">
          <span>Wager Golf</span>
        </div>
        <nav class="foot-links">
          <a href="{{ routes.pathFor(lang, 'formats') }}">{{ t.footer.formats }}</a>
          <a href="{{ routes.pathFor(lang, 'glossary') }}">{{ t.footer.glossary }}</a>
          <a href="{{ routes.pathFor(lang, 'about') }}">{{ t.footer.about }}</a>
          <a href="/privacy/">{{ t.footer.privacy }}</a>
          <a href="/terms/">{{ t.footer.terms }}</a>
          <a href="mailto:{{ site.email }}">{{ t.footer.contact }}</a>
        </nav>
        {%- include "language-switcher.njk" %}
      </div>
      <div class="foot-bottom">
        <span>© Gustaf Bratt</span>
        <span>{{ t.footer.tagline }}</span>
      </div>
    </div>
  </footer>

  <script defer src="/assets/js/reveal.js"></script>
  <script defer src="/assets/js/download-link.js{% if assets.download %}?v={{ assets.download }}{% endif %}"></script>
</body>
</html>
